# Copy this file to ".env" on your server and fill in real values.
# NEVER upload .env to GitHub.

# A long random secret. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# The name shown at the top of every page
APP_NAME=Student App

# Local development database. Leave DATABASE_URL blank to use SQLite.
DATABASE=data/app.db

# Supabase PostgreSQL connection string (use your project's pooler connection string).
# Configure this only for deployments that use Supabase.
DATABASE_URL=

# Supabase project URL and server-only service role key for private document storage.
# Never expose SUPABASE_SERVICE_ROLE_KEY in browser code or commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=creditready-documents
